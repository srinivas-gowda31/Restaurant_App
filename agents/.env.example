# Same free Groq key already used elsewhere in this project (backend/.env) — reused here so
# there's one provider/account to manage, not two. Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
# Must match the model actually deployed on Groq right now (their lineup changes often — check
# https://console.groq.com/docs/models if this 404s). Passed to CrewAI's native OpenAI-compatible
# LLM client pointed at Groq's base URL (see src/config.py for why: Groq's model id for this one
# literally starts with "openai/", which needs care in CrewAI's model-string parsing).
AGENT_MODEL=openai/gpt-oss-120b

# The Node backend's admin API this service talks to — same host you run `npm run dev` on.
NODE_ADMIN_BASE_URL=http://localhost:4000/api/admin
# Same value as ADMIN_API_KEY in backend/.env — this service authenticates to Node exactly like
# the admin panel frontend does (X-Admin-Key header), no direct database access at all.
ADMIN_API_KEY=your_admin_key_here

# How often the background triage loop runs, in seconds.
RUN_INTERVAL_SECONDS=120
