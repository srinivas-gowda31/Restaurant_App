generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  menuItems         MenuItem[]
  spaServices       SpaService[]
  housekeepingItems HousekeepingItem[]
  libraryItems      LibraryItem[]
  uploads           Upload[]
  sessions          Session[]
  orders            Order[]
  tokenUsages       TokenUsage[]
  frontDeskAlerts   FrontDeskAlert[]
  rooms             Room[]
}

model Room {
  id         String   @id @default(cuid())
  hotelId    String
  number     String
  guestName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, number])
  @@index([hotelId])
}

model MenuItem {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  category    String
  cuisine     String?
  vegetarian  Boolean  @default(true)
  price       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  orderItems OrderItem[]

  @@index([hotelId])
}

model SpaService {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  category    String
  durationMin Int?
  price       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  orderItems OrderItem[]

  @@index([hotelId])
}

model HousekeepingItem {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  category    String
  price       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  orderItems OrderItem[]

  @@index([hotelId])
}

model LibraryItem {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  category    String
  author      String?
  price       Float    @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  orderItems OrderItem[]

  @@index([hotelId])
}

model Upload {
  id                String   @id @default(cuid())
  hotelId           String
  type              String
  fileName          String
  status            String   @default("pending_review")
  rawExtractionJson String?
  createdAt         DateTime @default(now())
  reviewedAt        DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId])
}

model Session {
  id         String   @id
  hotelId    String
  roomNumber String?
  guestName  String?
  createdAt  DateTime @default(now())

  hotel      Hotel         @relation(fields: [hotelId], references: [id])
  messages   ChatMessage[]
  voiceLogs  VoiceLog[]
  orders     Order[]
  tokenUsages TokenUsage[]
  frontDeskAlerts FrontDeskAlert[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model VoiceLog {
  id         String   @id @default(cuid())
  sessionId  String
  transcript String
  createdAt  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model Order {
  id          String   @id @default(cuid())
  hotelId     String
  sessionId   String
  guestName   String?
  roomNumber  String?
  status      String   @default("confirmed")
  total       Float
  createdAt   DateTime @default(now())

  hotel   Hotel       @relation(fields: [hotelId], references: [id])
  session Session     @relation(fields: [sessionId], references: [id])
  items   OrderItem[]

  @@index([hotelId])
  @@index([sessionId])
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  menuItemId         String?
  spaServiceId       String?
  housekeepingItemId String?
  libraryItemId      String?
  department         String  @default("kitchen")
  name               String
  quantity           Int     @default(1)
  unitPrice          Float

  order            Order             @relation(fields: [orderId], references: [id])
  menuItem         MenuItem?         @relation(fields: [menuItemId], references: [id])
  spaService       SpaService?       @relation(fields: [spaServiceId], references: [id])
  housekeepingItem HousekeepingItem? @relation(fields: [housekeepingItemId], references: [id])
  libraryItem      LibraryItem?      @relation(fields: [libraryItemId], references: [id])

  @@index([orderId])
}

model KitchenTicket {
  id         String   @id @default(cuid())
  orderId    String
  orderItemId String  @unique
  itemName   String
  quantity   Int
  roomNumber String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  // Set by the CrewAI ops-agent layer (agents/), never by guest-facing tools.js — a triage
  // pass over pending tickets, not a guest-visible field. "low" | "normal" | "high" | "urgent".
  priority   String?
  agentNote  String?

  @@index([orderId])
}

model HousekeepingRequest {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String   @unique
  itemName    String
  quantity    Int
  roomNumber  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  priority    String?
  agentNote   String?

  @@index([orderId])
}

model SpaBooking {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String   @unique
  itemName    String
  quantity    Int
  roomNumber  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  priority    String?
  agentNote   String?

  @@index([orderId])
}

model TokenUsage {
  id               String   @id @default(cuid())
  hotelId          String
  sessionId        String
  // Distinguishes one voice call (one WebSocket connection) from another within the
  // same persistent guest sessionId, so "conversations" in usage stats means "calls",
  // not "this guest's entire visit". Null for text chat, where sessionId already is
  // the right grouping (no separate call boundary exists).
  callId           String?
  source           String // "chat" | "voice"
  model            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  createdAt        DateTime @default(now())

  hotel   Hotel   @relation(fields: [hotelId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([hotelId])
  @@index([callId])
  @@index([sessionId])
}

model FrontDeskAlert {
  id         String   @id @default(cuid())
  hotelId    String
  sessionId  String
  issue      String
  roomNumber String?
  urgency    String   @default("normal") // "normal" | "urgent"
  status     String   @default("open") // "open" | "acknowledged" | "resolved"
  createdAt  DateTime @default(now())
  // Set by the CrewAI ops-agent layer (agents/) — may upgrade urgency after re-assessing.
  agentNote  String?

  hotel   Hotel   @relation(fields: [hotelId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([hotelId])
  @@index([sessionId])
}

model LibraryRequest {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String   @unique
  itemName    String
  quantity    Int
  roomNumber  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  priority    String?
  agentNote   String?

  @@index([orderId])
}
