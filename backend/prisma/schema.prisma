generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id        String   @id @default(cuid())
  name      String
  // URL-safe identifier a guest's QR code / session carries (?hotel=<slug>) so one shared
  // database can serve many hotels while each guest/session/order only ever touches its own
  // hotel's rows — this is the "different hotels with different data" requirement, done as
  // tenant-scoping rather than one physical database per hotel (simpler to run, standard
  // practice, and the schema already had hotelId on every table before this even existed).
  slug      String   @unique
  // Replaces the single global ADMIN_API_KEY — each hotel's admin panel authenticates with
  // its OWN key, looked up here, so one hotel's staff can never see another hotel's data
  // through the admin panel either. The original ADMIN_API_KEY value is preserved here for
  // the pre-existing default hotel so nothing already deployed breaks.
  adminApiKey String @unique
  createdAt DateTime @default(now())

  menuItems         MenuItem[]
  spaServices       SpaService[]
  housekeepingItems HousekeepingItem[]
  libraryItems      LibraryItem[]
  conciergeRequests ConciergeRequest[]
  uploads           Upload[]
  sessions          Session[]
  orders            Order[]
  tokenUsages       TokenUsage[]
  frontDeskAlerts   FrontDeskAlert[]
  rooms             Room[]
}

model Room {
  id         String   @id @default(cuid())
  hotelId    String
  number     String
  guestName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, number])
  @@index([hotelId])
}

model MenuItem {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  category    String
  cuisine     String?
  breakfast   Boolean  @default(false)
  snack       Boolean  @default(false)
  vegetarian  Boolean  @default(true)
  price       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([hotelId])
}

model SpaService {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  category    String
  durationMin Int?
  price       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([hotelId])
}

model HousekeepingItem {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  category    String
  price       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([hotelId])
}

model LibraryItem {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  category    String
  author      String?
  price       Float    @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([hotelId])
}

model Upload {
  id                String   @id @default(cuid())
  hotelId           String
  type              String
  fileName          String
  status            String   @default("pending_review")
  rawExtractionJson String?
  createdAt         DateTime @default(now())
  reviewedAt        DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId])
}

model Session {
  id         String   @id
  hotelId    String
  roomNumber String?
  guestName  String?
  createdAt  DateTime @default(now())

  hotel      Hotel         @relation(fields: [hotelId], references: [id])
  messages   ChatMessage[]
  voiceLogs  VoiceLog[]
  orders     Order[]
  tokenUsages TokenUsage[]
  frontDeskAlerts FrontDeskAlert[]
  conciergeRequests ConciergeRequest[]
  cartItems  CartItem[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model VoiceLog {
  id         String   @id @default(cuid())
  sessionId  String
  transcript String
  createdAt  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model Order {
  id          String   @id @default(cuid())
  hotelId     String
  sessionId   String
  guestName   String?
  roomNumber  String?
  status      String   @default("confirmed")
  total       Float
  createdAt   DateTime @default(now())

  hotel   Hotel       @relation(fields: [hotelId], references: [id])
  session Session     @relation(fields: [sessionId], references: [id])
  items   OrderItem[]

  @@index([hotelId])
  @@index([sessionId])
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  menuItemId         String?
  spaServiceId       String?
  housekeepingItemId String?
  libraryItemId      String?
  department         String  @default("kitchen")
  name               String
  quantity           Int     @default(1)
  unitPrice          Float

  order            Order             @relation(fields: [orderId], references: [id])
  menuItem         MenuItem?         @relation(fields: [menuItemId], references: [id])
  spaService       SpaService?       @relation(fields: [spaServiceId], references: [id])
  housekeepingItem HousekeepingItem? @relation(fields: [housekeepingItemId], references: [id])
  libraryItem      LibraryItem?      @relation(fields: [libraryItemId], references: [id])

  @@index([orderId])
}

// A guest's in-progress order before confirm_order — persisted (not in-memory) so it survives
// a server restart/redeploy, and works if the backend ever runs as more than one instance.
// Mirrors OrderItem's shape since confirmOrder converts one into the other.
model CartItem {
  id                 String  @id @default(cuid())
  sessionId          String
  menuItemId         String?
  spaServiceId       String?
  housekeepingItemId String?
  libraryItemId      String?
  department         String  @default("kitchen")
  name               String
  quantity           Int     @default(1)
  unitPrice          Float
  createdAt          DateTime @default(now())

  session          Session           @relation(fields: [sessionId], references: [id])
  menuItem         MenuItem?         @relation(fields: [menuItemId], references: [id])
  spaService       SpaService?       @relation(fields: [spaServiceId], references: [id])
  housekeepingItem HousekeepingItem? @relation(fields: [housekeepingItemId], references: [id])
  libraryItem      LibraryItem?      @relation(fields: [libraryItemId], references: [id])

  @@index([sessionId])
}

model KitchenTicket {
  id         String   @id @default(cuid())
  orderId    String
  orderItemId String  @unique
  itemName   String
  quantity   Int
  roomNumber String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  // Set by the CrewAI ops-agent layer (agents/), never by guest-facing tools.js — a triage
  // pass over pending tickets, not a guest-visible field. "low" | "normal" | "high" | "urgent".
  priority   String?
  agentNote  String?

  @@index([orderId])
}

model HousekeepingRequest {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String   @unique
  itemName    String
  quantity    Int
  roomNumber  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  priority    String?
  agentNote   String?

  @@index([orderId])
}

model SpaBooking {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String   @unique
  itemName    String
  quantity    Int
  roomNumber  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  priority    String?
  agentNote   String?

  @@index([orderId])
}

model TokenUsage {
  id               String   @id @default(cuid())
  hotelId          String
  sessionId        String
  // Distinguishes one voice call (one WebSocket connection) from another within the
  // same persistent guest sessionId, so "conversations" in usage stats means "calls",
  // not "this guest's entire visit". Null for text chat, where sessionId already is
  // the right grouping (no separate call boundary exists).
  callId           String?
  source           String // "chat" | "voice"
  model            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  createdAt        DateTime @default(now())

  hotel   Hotel   @relation(fields: [hotelId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([hotelId])
  @@index([callId])
  @@index([sessionId])
}

model FrontDeskAlert {
  id         String   @id @default(cuid())
  hotelId    String
  sessionId  String
  issue      String
  roomNumber String?
  urgency    String   @default("normal") // "normal" | "urgent"
  status     String   @default("open") // "open" | "acknowledged" | "resolved"
  createdAt  DateTime @default(now())
  // Set by the CrewAI ops-agent layer (agents/) — may upgrade urgency after re-assessing.
  agentNote  String?

  hotel   Hotel   @relation(fields: [hotelId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([hotelId])
  @@index([sessionId])
}

// A real 5-star hotel's concierge desk: transportation/cab booking, tours/sightseeing,
// external restaurant reservations, currency exchange, courier/package requests — genuinely
// different from FrontDeskAlert (facility issues/complaints) and from a self-service catalog
// order (these need a human to actually go arrange something, not an instant price+add).
// Same shape/pattern as FrontDeskAlert deliberately, so it reuses the same admin-review
// workflow staff already know.
model ConciergeRequest {
  id         String   @id @default(cuid())
  hotelId    String
  sessionId  String
  category   String // "transportation" | "tour" | "reservation" | "currency_exchange" | "courier" | "other"
  details    String
  roomNumber String?
  guestName  String?
  urgency    String   @default("normal") // "normal" | "urgent"
  status     String   @default("open") // "open" | "in_progress" | "resolved"
  createdAt  DateTime @default(now())
  agentNote  String?

  hotel   Hotel   @relation(fields: [hotelId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([hotelId])
  @@index([sessionId])
}

model LibraryRequest {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String   @unique
  itemName    String
  quantity    Int
  roomNumber  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  priority    String?
  agentNote   String?

  @@index([orderId])
}
