DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
GEMINI_API_KEY=your_key_here
GEMINI_MODEL_CHAT=gemini-3.6-flash
GEMINI_MODEL_EXTRACT=gemini-3.1-pro-preview
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts
PORT=4000

# Text-chat provider (assistant.js): "gemini" (default if unset), "groq", or "openrouter".
# Gemini's free tier caps at ~20 requests/day (easy to exhaust in a demo) — groq (~1000/day
# free) is the recommended default.
CHAT_PROVIDER=groq
# Its OWN Groq key, separate from GROQ_API_KEY (extraction) and GROQ_CUISINE_API_KEY below —
# confirmed directly: sharing one key let chat traffic exhaust the whole account's 200K-
# tokens/day budget and silently break catalog uploads and cuisine tagging too, unrelated to how
# much either of those had actually been used. Every free Groq account gets its own independent
# daily budget, so a separate (also free) key per consumer means none can starve the others.
# Falls back to GROQ_API_KEY if left unset, but a dedicated key is strongly recommended.
GROQ_CHAT_API_KEY=your_groq_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Only needed if CHAT_PROVIDER=openrouter.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# CORS: comma-separated list of allowed frontend origin(s) in production. Leave unset in
# local dev (CORS stays open). With NODE_ENV=production and this unset, CORS fails closed.
ALLOWED_ORIGIN=
NODE_ENV=development

# Multi-hotel: each hotel has its OWN admin key, stored on its Hotel row (Hotel.adminApiKey),
# not a single shared secret — a hotel's key comes back once from POST /api/super-admin/hotels
# when it's created. This env var only seeds the very first hotel a fresh install starts with
# (see prisma/seed or the migration that backfills it) — every hotel after that gets its key
# from the super-admin endpoint instead. Generate one with:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_API_KEY=your_admin_key_here

# Protects /api/super-admin/* — onboarding brand-new hotels onto this shared database. Held by
# whoever operates this platform across every hotel, never given to any single hotel's own
# staff. Generate one the same way as ADMIN_API_KEY above.
SUPER_ADMIN_KEY=your_super_admin_key_here

# Azure OpenAI Realtime (GPT-4o Realtime) — powers the live voice-call mode
AZURE_OPENAI_REALTIME_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_REALTIME_API_KEY=your_azure_key_here
AZURE_OPENAI_REALTIME_DEPLOYMENT=your-realtime-deployment-name
AZURE_OPENAI_REALTIME_API_VERSION=2024-10-01-preview

# Catalog upload extraction (admin.js /upload): "gemini" (default), "azure", "local-ocr",
# "huggingface", or "groq".
# - azure: needs its own standard (non-realtime) GPT-4o deployment — the realtime deployment
#   above can't serve regular chat completions, so this needs deploy access you may not have.
# - local-ocr: PaddleOCR runs OCR in-process (no new deployment/account at all).
# - huggingface: an HF vision model via Hugging Face's free serverless Inference Providers — no
#   deployment needed, but the free allowance is only $0.10/month account-wide, which real usage
#   burns through fast. Kept as an option, not recommended as the primary provider.
# - groq (recommended): no dollar-credit system, just rate limits (~1000 req/day free) — enough
#   for regular admin uploads. See GROQ_* below.
# local-ocr/huggingface use Gemini's CHAT_MODEL to structure OCR'd text; groq structures with
# its own model. None of these touch Gemini's EXTRACT_MODEL, and chat (GEMINI_MODEL_CHAT above)
# is a separate, unaffected path regardless of which provider you pick here.
EXTRACTION_PROVIDER=gemini
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_EXTRACT_DEPLOYMENT=your-gpt4o-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21

# Hugging Face Inference Providers — free fine-grained token with "Make calls to Inference
# Providers" permission, from https://huggingface.co/settings/tokens/new
# Provider mappings change over time — if HF_OCR_MODEL ever 404s, check
# https://huggingface.co/api/models/<model>?expand=inferenceProviderMapping for a live one.
HF_TOKEN=your_hf_token_here
HF_OCR_MODEL=google/gemma-3-27b-it:deepinfra
# Defaults to HF_OCR_MODEL if unset — the same model OCRs the image and structures the result
# into JSON. Override only if you find a different HF model structures JSON more reliably.
HF_STRUCTURE_MODEL=google/gemma-3-27b-it:deepinfra

# Groq — free API key (no card) from https://console.groq.com/keys
# Groq's model lineup changes often (several models were deprecated within 2026 alone) — if
# either model below 404s, check https://console.groq.com/docs/models and
# https://console.groq.com/docs/deprecations for the current roster.
GROQ_API_KEY=your_groq_key_here
# Only vision-capable model on the free tier as of this writing (a "preview" model by Groq's
# own label — acceptable here since every extraction goes through manual admin review first).
GROQ_OCR_MODEL=qwen/qwen3.8-27b
# Text-only, production-status — structures the OCR'd text into JSON.
GROQ_STRUCTURE_MODEL=openai/gpt-oss-120b

# cuisineClassifier.js's own dedicated Groq key, separate from extraction's above and chat's
# GROQ_CHAT_API_KEY — same reasoning: isolates a big menu re-classification from competing with
# catalog uploads for the same daily budget. Falls back to GROQ_API_KEY if left unset.
GROQ_CUISINE_API_KEY=your_groq_key_here
